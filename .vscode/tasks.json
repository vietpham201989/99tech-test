{
  "version": "2.0.0",
  "tasks": [
    //ui_tests
    {
      "label": "Install library",
      "type": "shell",
      "command": "if [ \"$(uname)\" = \"Darwin\" ]; then sudo npm install && sudo npm ci && npx playwright install --with-deps; else npm install && npm ci && npx playwright install; fi",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "close": true
      }
    },
    {
      "label": "Run test cases of ui - chromium",
      "type": "shell",
      "command": "RUNNING_ENV=${input:env_ui} npx playwright test --project=chromium --headed  ${input:ui_test_file}"
    },
    {
      "label": "Run test cases of ui - firefox",
      "type": "shell",
      "command": "RUNNING_ENV=${input:env_ui} npx playwright test --project=firefox --headed  ${input:ui_test_file}",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Run test cases of api",
      "type": "shell",
      "command": "RUNNING_ENV=${input:env_ui} npx playwright test --config=playwright.api.config.ts --workers=1  ${input:ui_test_file_api}"
    },
    {
      "label": "View allure report",
      "type": "shell",
      "command": "npx allure generate allure-results -o allure-report && npx allure open allure-report"
    }
  ],
  "inputs": [
    // ui_tests
    {
      "id": "env_ui",
      "type": "pickString",
      "description": "Select environment",
      "options": [".stg", ".uat "],
      "default": ".uat "
    },
    {
      "id": "ui_test_file",
      "type": "promptString",
      "description": "Enter the test file(s) to run or tags. Example: tests/e2e/*.spec.ts --grep '@regression'",
      "default": "tests/e2e/*.spec.ts --grep '@regression'"
    },
    {
      "id": "ui_test_file_api",
      "type": "promptString",
      "description": "Enter the test file(s) to run or tags. Example: tests/api/*.spec.ts --grep '@regression'",
      "default": "tests/api/*.spec.ts --grep '@regression'"
    }
  ]
}
